def update_timing():

    while True:

        try:

            with lock:

                close_time = (
                    state[
                        "kalshi"
                    ].get(
                        "close_time"
                    )
                )

                open_time = (
                    state[
                        "kalshi"
                    ].get(
                        "open_time"
                    )
                )

                if close_time is None:

                    state[
                        "countdown"
                    ] = None

                    state[
                        "phase"
                    ] = "WAITING"

                    state[
                        "window_progress"
                    ] = 0

                else:

                    remaining = max(
                        0,
                        int(
                            close_time
                            -
                            time.time()
                        )
                    )

                    state[
                        "countdown"
                    ] = remaining

                    duration = 15 * 60

                    if open_time:

                        duration = max(
                            60,
                            close_time
                            -
                            open_time
                        )

                    elapsed = (
                        duration
                        -
                        remaining
                    )

                    progress = clamp(
                        elapsed
                        /
                        duration,
                        0,
                        1
                    )

                    state[
                        "window_progress"
                    ] = (
                        progress
                        * 100
                    )

                    # Adaptive phases.

                    if remaining > 10 * 60:

                        state[
                            "phase"
                        ] = "EARLY"

                    elif remaining > 5 * 60:

                        state[
                            "phase"
                        ] = "MIDDLE"

                    elif remaining > 60:

                        state[
                            "phase"
                        ] = "LATE"

                    else:

                        state[
                            "phase"
                        ] = "FINAL_MINUTE"

            time.sleep(1)

        except Exception as exc:

            log(
                f"TIMING_ERROR {exc}"
            )

            time.sleep(1)


