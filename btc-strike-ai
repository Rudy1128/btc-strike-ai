            ]
        )

        trend5 = (
            state[
                "trend_5m"
            ]
        )

        trend15 = (
            state[
                "trend_15m"
            ]
        )

        mom1 = (
            state[
                "momentum_1m"
            ]
        )

        mom5 = (
            state[
                "momentum_5m"
            ]
        )

        phase = (
            state[
                "phase"
            ]
        )

        if (
            btc is None
            or
            target is None
            or
            remaining is None
        ):

            state[
                "verdict"
            ] = "WAITING"

            state[
                "confidence"
            ] = 50

            state[
                "reason"
            ] = (
                "Waiting for BTC and "
                "current Kalshi 15-minute "
                "market"
            )

            return

        # ====================================================
        # BASE SCORE
        # ====================================================

        score = 0.0

        reasons = []

        # ====================================================
        # 1. DISTANCE FROM STRIKE
        # ====================================================

        distance = (
            btc - target
        )

        distance_pct = (
            distance
            /
            target
        ) * 100

        state[
            "btc_vs_target"
        ] = distance

        # The closer the price is to
        # target, the less weight we give
        # raw location.

        distance_strength = clamp(
            abs(distance_pct)
            /
            0.15,
            0,
            1
        )

        score += (
            24
            *
            distance_strength
            *
            (
                1
                if distance > 0
                else -1
            )
        )

        if distance > 0:

            reasons.append(
                "BTC above strike"
            )

        elif distance < 0:

            reasons.append(
                "BTC below strike"
            )

        # ====================================================
        # 2. MULTI-TIMEFRAME TREND
        # ====================================================

        score += (
            12
            if trend1 == "UP"
            else
            -12
            if trend1 == "DOWN"
            else
            0
        )

        score += (
            16
            if trend5 == "UP"
            else
            -16
            if trend5 == "DOWN"
            else
            0
        )

        score += (
            10
            if trend15 == "UP"
            else
            -10
            if trend15 == "DOWN"
            else
            0
        )

        # ====================================================
        # 3. MOMENTUM
        # ====================================================

        if mom1 is not None:

            score += clamp(
                mom1 * 12,
                -12,
                12
            )

        if mom5 is not None:

            score += clamp(
                mom5 * 8,
                -8,
                8
            )

        # ====================================================
        # 4. RSI
        # ====================================================

        if rsi is not None:

            if 52 <= rsi <= 68:

                score += 9

            elif 32 <= rsi < 48:

                score -= 9

            elif rsi > 72:

                score -= 5

            elif rsi < 28:

                score += 5

        # ====================================================
        # 5. DELTA
        # ====================================================

        delta_strength = clamp(
            abs(delta)
            /
            max(
                0.001,
                abs(
                    state[
                        "buy_volume"
                    ]
                    +
                    state[
                        "sell_volume"
                    ]
                )
            ),
            0,
            1
        )

        score += (
            14
            *
            delta_strength
            *
            (
                1
                if delta > 0
                else
                -1
                if delta < 0
                else
                0
            )
        )

        # ====================================================
        # 6. CVD
        # ====================================================

        cvd_signal = 0

        if cvd > 0:
            cvd_signal = 1

        elif cvd < 0:
            cvd_signal = -1

        score += (
            8
            *
            cvd_signal
        )

        # ====================================================
        # 7. ORDER BOOK
        # ====================================================

        score += (
            10
            *
            clamp(
                imbalance,
                -1,
                1
            )
        )

        # ====================================================
        # 8. TREND AGREEMENT BONUS
        # ====================================================

        up_count = sum(
            [
                trend1 == "UP",
                trend5 == "UP",
                trend15 == "UP"
            ]
        )

        down_count = sum(
            [
                trend1 == "DOWN",
                trend5 == "DOWN",
                trend15 == "DOWN"
            ]
        )

        if up_count == 3:

            score += 10

            reasons.append(
                "multi-timeframe UP agreement"
            )

        elif down_count == 3:

            score -= 10

            reasons.append(
                "multi-timeframe DOWN agreement"
            )

        # ====================================================
        # 9. PHASE ADAPTATION
        # ====================================================

        # Early:
        # Don't overreact to one tick.

        if phase == "EARLY":

            score *= 0.82

        # Middle:
        # Normal weighting.

        elif phase == "MIDDLE":

            score *= 1.00

        # Late:
        # Require stronger confirmation.

        elif phase == "LATE":

            score *= 1.12

        # Final minute:
        #
        # Kalshi BTC settlement uses the
        # final 60 seconds of BRTI.
        #
        # We become more conservative rather
        # than blindly chasing the latest tick.

        elif phase == "FINAL_MINUTE":

            score *= 1.28

        # ====================================================
        # 10. CONFLICT PENALTY
        # ====================================================

        conflicting = (
            up_count > 0
            and
            down_count > 0
        )

        if conflicting:

            score *= 0.72

            reasons.append(
                "timeframe conflict"
            )

        # ====================================================
        # 11. EXTREME RSI CAUTION
        # ====================================================

        if rsi is not None:

            if rsi >= 80:

                score *= 0.78

                reasons.append(
                    "overbought caution"
                )

            elif rsi <= 20:

                score *= 0.78

                reasons.append(
                    "oversold caution"
                )

        # ====================================================
        # 12. SPREAD QUALITY
        # ====================================================

        if spread is not None:

            if spread > 20:

                score *= 0.85

                reasons.append(
                    "wide BTC spread"
                )

        # ====================================================
        # 13. ADAPTIVE ACCURACY
        # ====================================================

        accuracy = (
            state[
                "adaptive_accuracy"
            ]
        )

        if accuracy < 45:

            score *= 0.75

        elif accuracy > 60:

            score *= 1.05

        # ====================================================
        # FINAL DECISION
        # ====================================================

        score = clamp(
            score,
            -100,
            100
        )

        # Confidence is based on:
        #
        # strength
        # + agreement
        # - conflicts
        #
        raw_confidence = (
            50
            +
            abs(score)
            * 0.48
        )

        if conflicting:

            raw_confidence -= 10

        # Final minute requires
        # much stronger evidence.

        if (
            phase == "FINAL_MINUTE"
            and
            abs(score) < 35
        ):

            verdict = "WAITING"

            raw_confidence = 50

            reasons.append(
                "final-minute confirmation too weak"
            )

        elif score >= 28:

            verdict = "UP"

        elif score <= -28:

            verdict = "DOWN"

        else:

            verdict = "WAITING"

            raw_confidence = 50

        confidence = clamp(
            raw_confidence,
            50,
            99
        )

        # ====================================================
        # MODEL PROBABILITY
        # ====================================================

        up_probability = clamp(
            50 + score * 0.5,
            1,
            99
        )

        down_probability = (
            100
            -
            up_probability
        )

        state[
            "score"
        ] = round(
            score,
            2
        )

        state[
            "up_score"
        ] = round(
            up_probability,
            1
        )

        state[
            "down_score"
        ] = round(
            down_probability,
            1
        )

        state[
            "confidence"
        ] = round(
            confidence,
            1
        )

        state[
            "verdict"
        ] = verdict

        if reasons:

            state[
                "reason"
            ] = " • ".join(
                reasons[:4]
            )

        else:

            state[
                "reason"
            ] = (
                "Signals not strong enough"
            )


# ============================================================
# ADAPTIVE PERFORMANCE
# ============================================================

last_recorded_ticker = None


def finalize_previous_prediction():

    global last_recorded_ticker

    ticker = (
        state[
            "kalshi"
        ].get(
            "ticker"
        )
    )

    if not ticker:
        return

    if (
        ticker
        ==
        last_recorded_ticker
    ):

        return

    verdict = (
        state[
            "verdict"
        ]
    )

    target = (
        state[
            "kalshi"
        ].get(
            "target"
        )
    )

    btc = state[
        "btc"
    ]

    if (
        verdict
        not in
        [
            "UP",
            "DOWN"
        ]
        or
        target is None
        or
        btc is None
    ):

        last_recorded_ticker = ticker

        return

    actual_up = (
        btc >= target
    )

    prediction_up = (
        verdict == "UP"
    )

    correct = (
        actual_up
        ==
        prediction_up
    )

    record = {

        "ticker":
            ticker,

        "prediction":
            verdict,

        "target":
            target,

        "btc":
            btc,

        "correct":
            correct,

        "time":
            now_iso()
    }

    prediction_history.append(
        record
    )

    if correct:

        state[
            "wins"
        ] += 1

    else:

        state[
            "losses"
        ] += 1

    total = (
        state[
            "wins"
        ]
        +
        state[
            "losses"
        ]
    )

    if total:

        state[
            "adaptive_accuracy"
        ] = round(
            (
                state[
                    "wins"
                ]
                /
                total
            )
            *
            100,
            1
        )

    state[
        "prediction_history"
    ] = list(
        prediction_history
    )

    last_recorded_ticker = ticker

    log(
        f"WINDOW_RESULT "
        f"{ticker} "
        f"{verdict} "
        f"{'WIN' if correct else 'LOSS'} "
        f"ACC={state['adaptive_accuracy']}"
    )


