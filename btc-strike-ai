# ============================================================

def kalshi_worker():

    while True:

        try:

            discover_market()

        except Exception as exc:

            log(
                f"KALSHI_WORKER_ERROR {exc}"
            )

        # Market metadata changes
        # slower than trade data.

        time.sleep(5)


# ============================================================
# BTC FALLBACK WORKER
# ============================================================

def fallback_worker():

    while True:

        try:

            with lock:

                connected = (
                    state[
                        "btc_status"
                    ]
                    ==
                    "CONNECTED"
                )

            if not connected:

                price = (
                    get_binance_price()
                )

                if price is not None:

                    with lock:

                        state[
                            "previous_btc"
                        ] = (
                            state[
                                "btc"
                            ]
                        )

                        state[
                            "btc"
                        ] = price

                        state[
                            "last_btc_update"
                        ] = now_iso()

                        state[
                            "btc_status"
                        ] = "REST"

            time.sleep(3)

        except Exception as exc:

            log(
                f"FALLBACK_ERROR {exc}"
            )

            time.sleep(3)


