def process_book(
    bid,
    bid_size,
    ask,
    ask_size
):

    with lock:

        state["bid"] = bid
        state["ask"] = ask

        state["bid_size"] = bid_size
        state["ask_size"] = ask_size

        state["spread"] = (
            ask - bid
            if bid is not None
            and ask is not None
            else None
        )

        total = (
            bid_size
            +
            ask_size
        )

        if total > 0:

            state[
                "book_imbalance"
            ] = (
                bid_size
                -
                ask_size
            ) / total

        else:

            state[
                "book_imbalance"
            ] = 0.0


