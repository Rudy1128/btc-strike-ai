function money(value) {

    if (
        value === null ||
        value === undefined
    ) {
        return "—";
    }

    return "$" +
        Number(value)
        .toLocaleString(
            undefined,
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }
        );
}


function clock(seconds) {

    if (
        seconds === null ||
        seconds === undefined
    ) {
        return "—";
    }

    seconds = Math.max(
        0,
        Number(seconds)
    );

    const m =
        Math.floor(
            seconds / 60
        );

    const s =
        seconds % 60;

    return String(m)
        .padStart(2, "0")
        +
        ":"
        +
        String(s)
        .padStart(2, "0");
}


function set(id, value) {

    const el =
        document.getElementById(id);

    if (el) {
        el.textContent = value;
    }
}


function trendText(value) {

    if (!value) {
        return "—";
    }

    return value;
}


function update(data) {

    set(
        "btc",
        money(data.btc)
    );

    set(
        "target",
        money(
            data.kalshi?.target
        )
    );

    set(
        "countdown",
        clock(
            data.countdown
        )
    );

    const diff =
        data.btc_vs_target;

    set(
        "difference",
        diff === null ||
        diff === undefined
            ? "—"
            :
            (
                diff >= 0
                    ? "+"
                    : ""
            )
            +
            Number(diff)
            .toFixed(2)
    );

    set(
        "kalshiUp",
        data.kalshi?.up_probability
            == null
            ? "—"
            :
            Number(
                data.kalshi.up_probability
            ).toFixed(1)
            +
            "%"
    );

    set(
        "modelUp",
        Number(
            data.up_score || 50
        ).toFixed(1)
        +
        "%"
    );

    set(
        "rsi",
        data.rsi == null
            ? "—"
            :
            Number(
                data.rsi
            ).toFixed(1)
    );

    set(
        "phase",
        data.phase || "WAITING"
    );

    set(
        "trend1",
        trendText(
            data.trend_1m
        )
    );

    set(
        "trend5",
        trendText(
            data.trend_5m
        )
    );

    set(
        "trend15",
        trendText(
            data.trend_15m
        )
    );

    set(
        "delta",
        Number(
            data.delta || 0
        ).toFixed(4)
    );

    set(
        "cvd",
        Number(
            data.cvd || 0
        ).toFixed(4)
    );

    set(
        "imbalance",
        (
            Number(
                data.book_imbalance || 0
            ) * 100
        ).toFixed(1)
        +
        "%"
    );

    set(
        "upScore",
        Number(
            data.up_score || 50
        ).toFixed(1)
        +
        "%"
    );

    set(
        "downScore",
        Number(
            data.down_score || 50
        ).toFixed(1)
        +
        "%"
    );

    const up =
        Number(
            data.up_score || 50
        );

    document.getElementById(
        "upBar"
    ).style.width =
        up + "%";

    document.getElementById(
        "downBar"
    ).style.width =
        (100 - up) + "%";

    set(
        "wins",
        data.wins || 0
    );

    set(
        "losses",
        data.losses || 0
    );

    set(
        "accuracy",
        Number(
            data.adaptive_accuracy || 50
        ).toFixed(1)
        +
        "%"
    );

    set(
        "score",
        Number(
            data.score || 0
        ).toFixed(1)
    );

    set(
        "btcStatus",
        data.btc_status || "—"
    );

    set(
        "kalshiStatus",
        data.kalshi_status || "—"
    );

    set(
        "ticker",
        data.kalshi?.ticker || "—"
    );

    set(
        "verdict",
        data.verdict || "WAITING"
    );

    set(
        "confidence",
        "Confidence "
        +
        Number(
            data.confidence || 50
        ).toFixed(0)
        +
        "%"
    );

    set(
        "reason",
        data.reason ||
        "Waiting for stronger confirmation..."
    );


    const verdict =
        document.getElementById(
            "verdict"
        );

    verdict.className =
        "verdict-main " +
        (
            data.verdict === "UP"
                ? "green"
                :
            data.verdict === "DOWN"
                ? "red"
                :
                "yellow"
        );
}


async function refresh() {

    try {

        const response =
            await fetch(
                "/api/state",
                {
                    cache:
                        "no-store"
                }
            );

        const data =
            await response.json();

        update(data);

    } catch (error) {

        console.log(
            "Refresh error",
            error
        );
    }
}


refresh();

setInterval(
    refresh,
    1000
);

</script>

