def websocket_worker():

    while True:

        try:

            log(
                "CONNECTING_BINANCE"
            )

            def on_open(ws):

                with lock:

                    state[
                        "btc_status"
                    ] = "CONNECTED"

                    state[
                        "error"
                    ] = None

                log(
                    "BINANCE_CONNECTED"
                )

            def on_message(
                ws,
                message
            ):

                try:

                    outer = json.loads(
                        message
                    )

                    data = outer.get(
                        "data",
                        outer
                    )

                    event_type = data.get(
                        "e"
                    )

                    # ---------------------
                    # Aggressive trades
                    # ---------------------

                    if event_type == "aggTrade":

                        price = safe_float(
                            data.get("p")
                        )

                        quantity = safe_float(
                            data.get("q")
                        )

                        maker = bool(
                            data.get(
                                "m",
                                False
                            )
                        )

                        if (
                            price is not None
                            and
                            quantity is not None
                        ):

                            process_trade(
                                price,
                                quantity,
                                maker
                            )

                    # ---------------------
                    # Best bid/ask
                    # ---------------------

                    elif event_type == "bookTicker":

                        bid = safe_float(
                            data.get("b")
                        )

                        ask = safe_float(
                            data.get("a")
                        )

                        bid_size = safe_float(
                            data.get("B"),
                            0.0
                        )

                        ask_size = safe_float(
                            data.get("A"),
                            0.0
                        )

                        if (
                            bid is not None
                            and
                            ask is not None
                        ):

                            process_book(
                                bid,
                                bid_size,
                                ask,
                                ask_size
                            )

                except Exception as exc:

                    log(
                        f"WS_MESSAGE_ERROR {exc}"
                    )

            def on_error(
                ws,
                error
            ):

                with lock:

                    state[
                        "btc_status"
                    ] = "ERROR"

                    state[
                        "error"
                    ] = str(error)

                log(
                    f"WS_ERROR {error}"
                )

            def on_close(
                ws,
                code,
                message
            ):

                with lock:

                    state[
                        "btc_status"
                    ] = "RECONNECTING"

                log(
                    f"WS_CLOSED {code} {message}"
                )

            ws = websocket.WebSocketApp(

                BINANCE_WS,

                on_open=on_open,

                on_message=on_message,

                on_error=on_error,

                on_close=on_close
            )

            ws.run_forever(
                ping_interval=20,
                ping_timeout=10
            )

        except Exception as exc:

            log(
                f"WS_WORKER_ERROR {exc}"
            )

        time.sleep(2)


