def market_target(market):

    for key in [
        "floor_strike",
        "cap_strike",
        "functional_strike",
        "strike",
        "target"
    ]:

        value = market.get(
            key
        )

        number = safe_float(
            value
        )

        if number is not None:

            return number

    # Some markets encode the target
    # in the subtitle/title.

    text = " ".join(
        str(
            market.get(
                key,
                ""
            )
        )
        for key in [
            "title",
            "subtitle",
            "yes_sub_title",
            "no_sub_title"
        ]
    )

    import re

    matches = re.findall(
        r"\$?\s*([\d,]{5,}(?:\.\d+)?)",
        text
    )

    values = []

    for match in matches:

        try:

            number = float(
                match.replace(
                    ",",
                    ""
                )
            )

            if (
                10000
                <= number
                <= 500000
            ):

                values.append(
                    number
                )

        except Exception:
            pass

    if values:

        return values[-1]

    return None


def probability(market):

    for key in [
        "yes_ask_dollars",
        "yes_bid_dollars",
        "last_price_dollars"
    ]:

        value = safe_float(
            market.get(key)
        )

        if value is not None:

            if value <= 1:
                return value * 100

            if value <= 100:
                return value

    for key in [
        "yes_ask",
        "yes_bid",
        "last_price"
    ]:

        value = safe_float(
            market.get(key)
        )

        if value is not None:

            if value <= 1:
                return value * 100

            return value

    return None


def discover_market():

    markets = get_markets()

    if not markets:

        return

    now = time.time()

    candidates = []

    for market in markets:

        ticker = str(
            market.get(
                "ticker",
                ""
            )
        )

        event_ticker = str(
            market.get(
                "event_ticker",
                ""
            )
        )

        title = str(
            market.get(
                "title",
                ""
            )
        ).lower()

        # Strong filter:
        #
        # We specifically want
        # the BTC 15-minute series.

        is_btc_15m = (
            ticker.startswith(
                MARKET_SERIES
            )
            or
            event_ticker.startswith(
                MARKET_SERIES
            )
            or
            (
                "btc" in title
                and
                "15" in title
            )
        )

        if not is_btc_15m:

            continue

        target = market_target(
            market
        )

        if target is None:

            continue

        close_time = (
            parse_time(
                market.get(
                    "close_time"
                )
            )
            or
            parse_time(
                market.get(
                    "expiration_time"
                )
            )
            or
            parse_time(
                market.get(
                    "latest_expiration_time"
                )
            )
        )

        if close_time is None:

            continue

        seconds_left = (
            close_time - now
        )

        # Current 15-minute market.
        #
        # Never select a market with
        # hours remaining.

        if (
            seconds_left <= 0
            or
            seconds_left > 16 * 60
        ):

            continue

        open_time = parse_time(
            market.get(
                "open_time"
            )
        )

        # Prefer the market with
        # the shortest remaining time
        # among legitimate current
        # windows.

        candidates.append(
            (
                seconds_left,
                market,
                target,
                close_time,
                open_time
            )
        )

    if not candidates:

        with lock:

            state[
                "kalshi_status"
            ] = "SEARCHING"

        log(
            "KALSHI_15M_NOT_FOUND"
        )

        return

    candidates.sort(
        key=lambda item: item[0]
    )

    (
        seconds_left,
        market,
        target,
        close_time,
        open_time
    ) = candidates[0]

    up = probability(
        market
    )

    with lock:

        old_ticker = (
            state[
                "kalshi"
            ].get(
                "ticker"
            )
        )

        new_ticker = (
            market.get(
                "ticker"
            )
        )

        # New window detected.

        if (
            old_ticker
            and
            new_ticker
            != old_ticker
        ):

            finalize_previous_prediction()

            # Reset short-term
            # order flow for new window.

            state[
                "delta"
            ] = 0.0

            state[
                "cvd"
            ] = 0.0

        state[
            "kalshi"
        ] = {

            "ticker":
                new_ticker,

            "event_ticker":
                market.get(
                    "event_ticker"
                ),

            "target":
                target,

            "up_probability":
                up,

            "down_probability":
                (
                    100 - up
                    if up is not None
                    else None
                ),

            "close_time":
                close_time,

            "open_time":
                open_time,

            "title":
                market.get(
                    "title"
                )
                or
                market.get(
                    "subtitle"
                ),

            "volume":
                safe_float(
                    market.get(
                        "volume_fp"
                    )
                    or
                    market.get(
                        "volume"
                    )
                )
        }

        state[
            "kalshi_status"
        ] = "CONNECTED"

        state[
            "error"
        ] = None

    log(
        f"KALSHI_15M "
        f"{new_ticker} "
        f"TARGET={target} "
        f"LEFT={round(seconds_left)} "
        f"UP={up}"
    )


