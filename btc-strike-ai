def calculate_ema(values, period):

    if len(values) < period:
        return None

    multiplier = 2 / (
        period + 1
    )

    ema = sum(
        values[:period]
    ) / period

    for value in values[period:]:

        ema = (
            value * multiplier
            +
            ema * (
                1 - multiplier
            )
        )

    return ema


def calculate_rsi(
    values,
    period=14
):

    if len(values) < period + 1:
        return None

    gains = []
    losses = []

    for i in range(
        1,
        len(values)
    ):

        change = (
            values[i]
            -
            values[i - 1]
        )

        if change >= 0:

            gains.append(change)
            losses.append(0)

        else:

            gains.append(0)
            losses.append(
                abs(change)
            )

    recent_gains = (
        gains[-period:]
    )

    recent_losses = (
        losses[-period:]
    )

    avg_gain = (
        sum(recent_gains)
        /
        period
    )

    avg_loss = (
        sum(recent_losses)
        /
        period
    )

    if avg_loss == 0:

        return 100.0

    rs = (
        avg_gain
        /
        avg_loss
    )

    return (
        100
        -
        (
            100
            /
            (1 + rs)
        )
    )


def percent_change(
    values,
    periods
):

    if len(values) <= periods:
        return None

    old = values[-1 - periods]
    new = values[-1]

    if old == 0:
        return None

    return (
        (new - old)
        /
        old
    ) * 100


def classify_trend(
    values
):

    if len(values) < 30:
        return "WAIT"

    fast = calculate_ema(
        values[-30:],
        9
    )

    slow = calculate_ema(
        values[-30:],
        21
    )

    if fast is None or slow is None:
        return "WAIT"

    diff = (
        (fast - slow)
        /
        slow
    ) * 100

    if diff > 0.025:
        return "UP"

    if diff < -0.025:
        return "DOWN"

    return "FLAT"


