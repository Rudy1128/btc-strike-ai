def now_iso():
    return datetime.now(timezone.utc).isoformat()


def safe_float(value, default=None):

    try:

        if value is None:
            return default

        return float(value)

    except Exception:

        return default


def clamp(value, low, high):

    return max(
        low,
        min(high, value)
    )


def log(message):

    print(
        f"[BTC-STRIKE-AI] {message}",
        flush=True
    )


def parse_time(value):

    if not value:
        return None

    try:

        text = str(value)

        if text.endswith("Z"):
            text = text[:-1] + "+00:00"

        return datetime.fromisoformat(
            text
        ).timestamp()

    except Exception:

        return None


