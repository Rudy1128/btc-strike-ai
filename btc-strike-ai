def process_trade(
    price,
    quantity,
    buyer_is_maker
):

    global current_minute

    timestamp = (
        int(time.time() // 60)
        * 60
    )

    with lock:

        # New minute
        if (
            current_minute is None
            or
            current_minute["timestamp"]
            != timestamp
        ):

            if current_minute:

                minute_candles.append(
                    current_minute
                )

            current_minute = {

                "timestamp":
                    timestamp,

                "open":
                    price,

                "high":
                    price,

                "low":
                    price,

                "close":
                    price,

                "volume":
                    0.0,

                "buy_volume":
                    0.0,

                "sell_volume":
                    0.0
            }

        else:

            current_minute["high"] = max(
                current_minute["high"],
                price
            )

            current_minute["low"] = min(
                current_minute["low"],
                price
            )

            current_minute["close"] = price

        current_minute[
            "volume"
        ] += quantity

        if buyer_is_maker:

            current_minute[
                "sell_volume"
            ] += quantity

        else:

            current_minute[
                "buy_volume"
            ] += quantity

        buy = (
            current_minute[
                "buy_volume"
            ]
        )

        sell = (
            current_minute[
                "sell_volume"
            ]
        )

        state["delta"] = (
            buy - sell
        )

        state["buy_volume"] = buy
        state["sell_volume"] = sell

        state["cvd"] += (
            quantity
            if not buyer_is_maker
            else -quantity
        )

        state["previous_btc"] = (
            state["btc"]
        )

        state["btc"] = price

        price_buffer.append(
            price
        )

        trade_buffer.append({
            "time": time.time(),
            "price": price,
            "qty": quantity,
            "buy": not buyer_is_maker
        })

        state[
            "last_btc_update"
        ] = now_iso()

        state[
            "btc_status"
        ] = "CONNECTED"


